# Güzel Teknoloji - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_BASE_URL=http://localhost:5000

# Backend (Node.js) - backend/.env dosyasında ayarlanmalı
JWT_SECRET=guzel-teknoloji-gizli-anahtar-2026
# Dis uygulama lisans kontrolu (varsayilan: kapali)
PAKET_ERISIM_AKTIF=false
PAKET_ERISIM_API_KEY=degistir-beni-guclu-bir-anahtar-yap
